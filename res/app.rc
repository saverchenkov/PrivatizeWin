#include <windows.h>
#include "resource.h"

// Application Icon
IDI_APPICON ICON "icon.ico"

// Main Application Menu
MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Export Configuration (JSON)...\tCtrl+E", IDM_FILE_EXPORT
        MENUITEM "&Import Configuration (JSON)...\tCtrl+O", IDM_FILE_IMPORT
        MENUITEM SEPARATOR
        MENUITEM "Restart as &Administrator...",             IDM_FILE_RESTART_ADMIN
        MENUITEM SEPARATOR
        MENUITEM "E&xit\tAlt+F4",                            IDM_FILE_EXIT
    END
    POPUP "&Presets"
    BEGIN
        MENUITEM "Select &Recommended Preset",              IDM_TPL_RECOMMENDED
        MENUITEM "Select &Strict Privacy Preset",           IDM_TPL_STRICT
        MENUITEM "Select &Minimal Preset",                  IDM_TPL_MINIMAL
    END
    POPUP "&Actions"
    BEGIN
        MENUITEM "&Apply Selected Settings\tCtrl+S",        IDM_ACT_APPLY
        MENUITEM "Restore Selected to Windows &Defaults...", IDM_ACT_RESTORE_SELECTED
        MENUITEM "Restore &All to Windows Defaults...",      IDM_ACT_RESTORE_ALL
        MENUITEM SEPARATOR
        MENUITEM "Select &Recommended",                     IDM_SEL_RECOMMENDED
        MENUITEM "Select All &Shown",                       IDM_SEL_ALL_SHOWN
        MENUITEM "&Invert Shown Selection",                 IDM_SEL_INVERT_SHOWN
        MENUITEM "&Clear Selection",                        IDM_SEL_CLEAR
        MENUITEM SEPARATOR
        MENUITEM "&Refresh System Audit\tF5",               IDM_ACT_REFRESH
        MENUITEM "Create &System Restore Point...",          IDM_ACT_RESTORE_PT
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "&Schedule Automatic Reapplication...",    IDM_TOOLS_SCHEDULE
        MENUITEM "Open Windows &Task Scheduler",            IDM_TOOLS_TASKSCHD
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About PrivatizeWin",                     IDM_HELP_ABOUT
        MENUITEM "Project &GitHub Repository",              IDM_HELP_GITHUB
    END
END

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "PrivatizeWin Project"
            VALUE "FileDescription",  "PrivatizeWin - Windows Privacy & Telemetry Silencer"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "PrivatizeWin"
            VALUE "LegalCopyright",   "Copyright (C) 2026. MIT License."
            VALUE "OriginalFilename", "PrivatizeWin.exe"
            VALUE "ProductName",      "PrivatizeWin"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
